b.com/bxf1/sciresearch-bench-lite/releases/download/v0.3-submission-20261024/thinking-only-report-manifest-20261025.json"},{"url":"https://api.github.com/repos/bxf1/sciresearch-bench-lite/releases/assets/674922159","id":674922159,"node_id":"RA_kwDOVS4v484oOn6v","name":"thinking-only-report-SHA256SUMS-20261025.txt","label":"","uploader":{"login":"bxf1","id":142134006,"node_id":"U_kgDOCHjK9g","avatar_url":"https://avatars.githubusercontent.com/u/142134006?v=4","gravatar_id":"","url":"https://api.github.com/users/bxf1","html_url":"https://github.com/bxf1","followers_url":"https://api.github.com/users/bxf1/followers","following_url":"https://api.github.com/users/bxf1/following{/other_user}","gists_url":"https://api.github.com/users/bxf1/gists{/gist_id}","starred_url":"https://api.github.com/users/bxf1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bxf1/subscriptions","organizations_url":"https://api.github.com/users/bxf1/orgs","repos_url":"https://api.github.com/users/bxf1/repos","events_url":"https://api.github.com/users/bxf1/events{/privacy}","received_events_url":"https://api.github.com/users/bxf1/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":428,"digest":"sha256:e07ee033354815c420c1a3fcfa30b5e5390c2cdb65f6ca93b2e69dc9734ba652","download_count":0,"created_at":"2026-10-25T11:56:08Z","updated_at":"2026-10-25T11:56:08Z","browser_download_url":"https://github.com/bxf1/sciresearch-bench-lite/releases/download/v0.3-submission-20261024/thinking-only-report-SHA256SUMS-20261025.txt"}],"tarball_url":"https://api.github.com/repos/bxf1/sciresearch-bench-lite/tarball/v0.3-submission-20261024","zipball_url":"https://api.github.com/repos/bxf1/sciresearch-bench-lite/zipball/v0.3-submission-20261024","body":"## 最终作业报告：thinking/max 专版（2026-10-25）\n\n[当前主报告](https://github.com/bxf1/sciresearch-bench-lite/blob/main/docs/submission-report-2026-10-24.md)已按作业要求复核；主报告、README、表格、图表、作者基线和端到端案例只展示 thinking/max 本批结果。解释 G1/G2/G3 与 r1/r2/r3，按任务、指导组、repeat 排序，并保留实际执行序号。\n\n**结果：15/15 有提交，14 项正式有效且成功，Poisson G2 正式计时无效。** G2 数值通过 12/12，独立补测原始耗时比 2.488× 仅作诊断，不换算成绩。作者基线 10 项有效、Jacobi-CG 独立准入拒绝，三条任务均有基线与端到端验证。修复、关联重试和无进展续接完整保留。\n\n- [下载 16 页 PDF](https://github.com/bxf1/sciresearch-bench-lite/releases/download/v0.3-submission-20261024/sciresearch-thinking-report-20261025.pdf)\n- [下载离线 HTML](https://github.com/bxf1/sciresearch-bench-lite/releases/download/v0.3-submission-20261024/sciresearch-thinking-report-20261025.html)\n- [15 行原始证据索引](https://github.com/bxf1/sciresearch-bench-lite/blob/main/docs/thinking-report-evidence-2026-10-25.md)\n- [作业要求检查与修正清单](https://github.com/bxf1/sciresearch-bench-lite/blob/main/docs/delivery-audit-thinking-2026-10-25.md)\n- [上一版材料暂存](https://github.com/bxf1/sciresearch-bench-lite/tree/main/archives/pre-thinking-only-20261025)：21 个文件与逐文件 SHA256，含上版报告、PDF、图表、分析和生成脚本。\n\n本次审计核对 77 个来源哈希、1,440 条保存的逐例评分记录、178 个本地链接和全部图表/日志节选；这些是已有重复记录的复核，不是新增实验。干净副本验证与数据表重建通过，无模型调用、无候选执行、未改冻结参数。\n\n报告源码提交：`1c8b452c6ea7c29c655cbda2f4f999fc15c7f575`。新增 `thinking-only-report-20261025.tar.gz`、同名 manifest 与 SHA256SUMS，另提供 PDF/HTML。增量包包含当前报告、图表、机器可读数据、审计脚本和上一版快照；与 main、作者数据及既有实验附件配合使用。\n\n全部既有 22 个附件保留，包含作者数据、完整原始实验、thinking 轨迹、修复、失败和计时拒绝。先前发布说明保存在 [release-before.json](https://github.com/bxf1/sciresearch-bench-lite/blob/main/logs/thinking-report-delivery-2026-10-25/release-before.json)。历史标签的自动源码 ZIP 不是当前 main 报告版本；旧阅读附件属于历史快照。\n\n局限：小样本、已使用过的隐藏集、模型路由内部版本不可锁定、中途执行器修复和宿主计时干扰；本版不宣称 thinking 的因果收益或真正 RSI。\n"}